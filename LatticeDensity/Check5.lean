module

/-!
# The finite check for at most five neighbours

The window has three rows of five cells, and a row is a number below 32. `okT` is the table of the triples of rows whose
middle row satisfies the condition, and `ok_table` proves that it has all of them. `ftab` and `gtab` are the two
potentials, plus 200, in base 512. Every inequality is evaluated by the kernel with arithmetic of natural numbers.
-/

@[expose] public section

namespace LatticeDensity.Check5

/-- All the numbers below `n` satisfy `p`. -/
def all (p : Nat → Bool) : Nat → Bool
  | 0 => true
  | n + 1 => p n && all p n

theorem all_spec {p : Nat → Bool} : ∀ {n : Nat}, all p n = true → ∀ k, k < n → p k = true
  | 0, _, _, hk => absurd hk (Nat.not_lt_zero _)
  | n + 1, h, k, hk => by
    simp only [all, Bool.and_eq_true] at h
    rcases Nat.lt_succ_iff_lt_or_eq.mp hk with h' | h'
    · exact all_spec h.2 k h'
    · exact h' ▸ h.1

/-- The number of live cells of a row of five cells. -/
def pc (x : Nat) : Nat := (0xb238da8da6918da691691448 >>> (3 * x)) % 8

/-- Bit `c + 32 a + 1024 b` tells whether the middle row `b` between the rows `a` and `c` satisfies the condition. -/
def okT : Nat := 

/-- The bits of the table for two given rows. -/
def okC (a b : Nat) : Nat := (okT >>> (32 * (a + 32 * b))) % 4294967296

def ok (a b c : Nat) : Bool := (okC a b >>> c) % 2 == 1

/-- The live cells among the neighbours of the cell `j` of the middle row. -/
def cnt (a b c : Nat) : Nat → Nat
  | 0 => a % 2 + a / 2 % 2 + b / 2 % 2 + c % 2 + c / 2 % 2
  | 1 => a % 2 + a / 2 % 2 + a / 4 % 2 + b % 2 + b / 4 % 2 + c % 2 + c / 2 % 2 + c / 4 % 2
  | 2 => a / 2 % 2 + a / 4 % 2 + a / 8 % 2 + b / 2 % 2 + b / 8 % 2 + c / 2 % 2 + c / 4 % 2 + c / 8 % 2
  | 3 => a / 4 % 2 + a / 8 % 2 + a / 16 % 2 + b / 4 % 2 + b / 16 % 2 + c / 4 % 2 + c / 8 % 2 + c / 16 % 2
  | _ => a / 8 % 2 + a / 16 % 2 + b / 8 % 2 + c / 8 % 2 + c / 16 % 2

/-- The condition on the middle row. -/
def spec (a b c : Nat) : Bool :=
  (b % 2 == 0 || Nat.ble (cnt a b c 0) 5) && (b / 2 % 2 == 0 || Nat.ble (cnt a b c 1) 5) &&
    (b / 4 % 2 == 0 || Nat.ble (cnt a b c 2) 5) && (b / 8 % 2 == 0 || Nat.ble (cnt a b c 3) 5) &&
    (b / 16 % 2 == 0 || Nat.ble (cnt a b c 4) 5)

theorem ok_table : all (fun a => all (fun b => all (fun c => !spec a b c || ok a b c) 32) 32) 32 = true := by
  decide +kernel

theorem ok_of_spec {a b c : Nat} (ha : a < 32) (hb : b < 32) (hc : c < 32) (h : spec a b c = true) : ok a b c = true := by
  have := all_spec (all_spec (all_spec ok_table a ha) b hb) c hc
  simpa [h] using this

/-- The potential of a pattern of three rows of four cells, plus 200. -/
def ftab : Nat := 

/-- The potential of a pattern of two rows of five cells, plus 200. -/
def gtab : Nat := 

/-- The part of the table for two given rows. -/
def fC (x y : Nat) : Nat := (ftab >>> (144 * (x + 16 * y))) % 2 ^ 144

def gC (x : Nat) : Nat := (gtab >>> (288 * x)) % 2 ^ 288

def fv (x y z : Nat) : Nat := (fC x y >>> (9 * z)) % 512

def gv (x y : Nat) : Nat := (gC x >>> (9 * y)) % 512

/-- The inequality in a window of three rows of five cells. -/
def good (x y z : Nat) : Bool :=
  Nat.ble (52 * (pc x + pc y + pc z) + fv (x % 16) (y % 16) (z % 16) + gv x y)
    (540 + fv (x / 2) (y / 2) (z / 2) + gv y z)

def row (x : Nat) : Bool :=
  all (fun y => !ok 0 x y || all (fun z => !ok x y z || !ok y z 0 || good x y z) 32) 32

theorem rows : all row 32 = true := by decide +kernel

theorem good_of_ok {x y z : Nat} (hx : x < 32) (hy : y < 32) (hz : z < 32) (h0 : ok 0 x y = true)
    (h1 : ok x y z = true) (h2 : ok y z 0 = true) : good x y z = true := by
  have h := all_spec (all_spec rows x hx) y hy
  simp only [h0, Bool.not_true, Bool.false_or] at h
  have h := all_spec h z hz
  simpa [h1, h2] using h

end LatticeDensity.Check5
